{:paths ["src"]
 ;; kotoba-code — a model-neutral, test-gated, kotoba-Datom-backed agentic coding
 ;; agent. Working operator start is compile + instantiateKotoba:
 ;;   sh scripts/kotoba-compile.sh
 ;;   sh scripts/kotoba-run.sh
 ;; Intended public command (CLI source-run gap until the CLI accepts this guest):
 ;;   kotoba run kotoba/main.kotoba
 ;; There is no kotoba -M. :run is gone (not leftover-jvm-run-path exit 2),
 ;; including :jvm-opts --enable-native-access=ALL-UNNAMED.
 ;; Do not wrap Datalevin/LMDB JNI as a C .so.
 ;; Leftover Java in src/kotoba_code/main.cljk stays as a library —
 ;; not a start path. Default CI is kotoba compile + instantiateKotoba.
 ;; Leftover library graph (not operator start):
 ;;   langchain — ChatModel (openai-model → OpenRouter/Murakumo) + tools + kotoba-db
 ;;   langgraph — create-react-agent loop + datomic-checkpointer (kotoba persistence)
 :deps {
        ;; kotoba.bytes replaced UTF-8 .getBytes / String. here (2026-09-24). An explicit
        ;; floor: tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/bytes {:git/sha "d5259f35ab7c4f5a66e63ca29ed4dcf7ba3f1ac5"}
        ;; kotoba.io replaced clojure.java.io here (2026-09-24). An explicit floor:
        ;; kotoba.io carries clojure.java.io's file/as-file/as-relative-path/
        ;; make-parents/delete-file from 98045c7, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/io {:git/sha "1b60ca825c1e705bd195f857ca4549133653a9f3"}
        ;; kotoba.process replaced clojure.java.shell here (2026-09-24). An explicit
        ;; floor: kotoba.process/sh parses clojure.java.shell's options from db49ea9,
        ;; and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/process {:git/sha "db49ea936e53d0bc698be0db79bf96ad86b5f7d0"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/langchain {:git/url "https://github.com/kotoba-lang/langchain.git"
                                         :sha "c7943d7542f28242a654ff3e0c37100b48a9417d"}
        io.github.kotoba-lang/langgraph {:git/url "https://github.com/kotoba-lang/langgraph.git"
                                         :sha "5b4e5e70837b849b14b6a5800894e3be202ad5fa"}
        io.github.kotoba-lang/json {:git/sha "15fd195ac41e6268e2005ccbf6cb9924e81e65e2"}
}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; leftover JVM lint (workflow_dispatch leftover-jvm.yml only).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
