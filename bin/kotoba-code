#!/usr/bin/env sh
set -eu

# Operator start is kotoba run / kotoba compile. There is no kotoba -M
# and no clojure -M / clj -M start path.
#
# Replaces the former:
#   clojure -M:run  (kotoba-code.main, :jvm-opts --enable-native-access=ALL-UNNAMED)
# That wrapper is gone, not leftover-jvm-run-path exit 2.
# Do not wrap Datalevin/LMDB JNI as a C .so.

SOURCE="$0"
while [ -L "$SOURCE" ]; do
  DIR="$(CDPATH= cd -- "$(dirname -- "$SOURCE")" && pwd)"
  TARGET="$(readlink "$SOURCE")"
  case "$TARGET" in
    /*) SOURCE="$TARGET" ;;
    *) SOURCE="$DIR/$TARGET" ;;
  esac
done

APP_DIR="$(CDPATH= cd -- "$(dirname -- "$SOURCE")/.." && pwd)"
cd "$APP_DIR"

if ! command -v kotoba >/dev/null 2>&1; then
  echo "kotoba CLI is not on PATH. Operator start is:" >&2
  echo "  kotoba run kotoba/main.kotoba" >&2
  echo "  kotoba compile kotoba/main.kotoba --target wasm --output target/kotoba/main.wasm --json" >&2
  echo "  kotoba compile kotoba/main.kotoba --target web --output target/kotoba/main.mjs --json" >&2
  echo "There is no kotoba -M and no clojure -M start." >&2
  exit 127
fi

exec kotoba run kotoba/main.kotoba "$@"
